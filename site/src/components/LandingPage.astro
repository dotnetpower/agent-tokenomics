<script is:inline>
  window.__setTpTab = function (tab) {
    var root = document.getElementById("tokprof-html-preview");
    if (!root) return;
    var buttons = root.querySelectorAll("[data-tp-tab]");
    for (var i = 0; i < buttons.length; i++) {
      var btn = buttons[i];
      btn.setAttribute("aria-selected", btn.getAttribute("data-tp-tab") === tab ? "true" : "false");
    }
    var panels = root.querySelectorAll("[data-tp-panel]");
    for (var j = 0; j < panels.length; j++) {
      var panel = panels[j];
      var kind = panel.getAttribute("data-tp-panel");
      if (tab === "all" || kind === tab) {
        panel.style.display = kind === "composition" ? "flex" : "block";
      } else {
        panel.style.display = "none";
      }
    }
  };
</script>
