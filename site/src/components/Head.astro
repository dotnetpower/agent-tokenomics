---
const { head, entry, lang, id, siteTitle } = Astro.locals.starlightRoute;
const data = entry?.data;
const documentDates = data?.created
  ? { datePublished: data?.created, dateModified: data?.updated }
  : {};
const root = new URL(import.meta.env.BASE_URL.replace(/\/?$/, "/"), Astro.site).href;
const isKo = lang === "ko";
const is404 = /(^|\/)404\/?$/.test(id);
const isHome = ["", "index", "ko", "ko/index"].includes(id);
const canonicalEntry = head.find((item) => item.tag === "link" && item.attrs?.rel === "canonical");
const canonical = String(canonicalEntry?.attrs?.href ?? new URL(Astro.url.pathname, Astro.site).href)
  .replace(/\/?$/, "/");
const title = is404
  ? `404 — ${isKo ? "페이지를 찾을 수 없습니다" : "Page not found"} | ${siteTitle}`
  : `${data?.title ?? siteTitle} | ${siteTitle}`;
const description = String(data?.description ?? (isKo
  ? "LLM 토큰 비용과 작업 품질을 함께 측정하는 영어·한국어 문서입니다."
  : "English and Korean documentation for measuring LLM token cost alongside task quality."));
const image = `${root}og-cover.png`;
const alternates = head.filter((item) => item.tag === "link" && item.attrs?.hreflang);
const enHref = alternates.find((item) => item.attrs?.hreflang === "en")?.attrs?.href;
const replacedMeta = new Set([
  "description", "robots", "og:title", "og:description", "og:url", "og:type",
  "og:locale", "og:image", "og:image:secure_url", "og:image:type", "og:image:width",
  "og:image:height", "og:image:alt", "twitter:card", "twitter:title",
  "twitter:description", "twitter:image", "twitter:image:alt",
]);
const filteredHead = head.filter((item) => {
  if (item.tag === "title") return false;
  if (item.tag === "link" && ["canonical", "sitemap"].includes(String(item.attrs?.rel))) return false;
  if (is404 && item.tag === "link" && item.attrs?.hreflang) return false;
  if (item.tag !== "meta") return true;
  return item.attrs?.charset === undefined &&
    !["viewport", ...replacedMeta].includes(String(item.attrs?.name ?? item.attrs?.property));
});
const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization", "@id": `${root}#organization`, name: "agent-tokenomics",
    url: root, sameAs: ["https://github.com/dotnetpower/agent-tokenomics"],
  },
  {
    "@type": "WebSite", "@id": `${root}#website`, url: root, name: "agent-tokenomics",
    inLanguage: ["en", "ko"], publisher: { "@id": `${root}#organization` },
  },
  {
    "@type": "WebPage", "@id": canonical, url: canonical, name: title, description,
    ...documentDates,
    inLanguage: isKo ? "ko" : "en", isPartOf: { "@id": `${root}#website` },
  },
];
if (!isHome && !is404) {
  graph.push({
    "@type": "TechArticle", "@id": `${canonical}#article`, url: canonical,
    ...documentDates,
    headline: data?.title, description, inLanguage: isKo ? "ko" : "en",
    mainEntityOfPage: { "@id": canonical }, image,
    publisher: { "@id": `${root}#organization` },
  });
  const home = `${root}${isKo ? "ko/" : ""}`;
  const cleanId = id.replace(/^ko\//, "");
  const track = cleanId.split("/")[0];
  const crumbs = [{ name: "agent-tokenomics", url: home }];
  if (cleanId.includes("/") && ["agent-tokenomics", "copilot-tokenomics"].includes(track))
    crumbs.push({ name: track === "agent-tokenomics" ? "Agent Tokenomics" : "Copilot Tokenomics", url: `${home}${track}/` });
  crumbs.push({ name: String(data?.title), url: canonical });
  graph.push({
    "@type": "BreadcrumbList", "@id": `${canonical}#breadcrumb`,
    itemListElement: crumbs.map((crumb, index) => ({
      "@type": "ListItem", position: index + 1, name: crumb.name, item: crumb.url,
    })),
  });
}
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph })
  .replace(/</g, "\\u003c");
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ||
  "jHE9O63_qT7gVGACSA-OA_2d1wzkue6urJ99MGSCzY8";
const naverVerification = import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{!is404 && data?.created && <meta name="date.created" content={data.created} />}
{!is404 && data?.updated && <meta name="date.updated" content={data.updated} />}
<meta name="robots" content={is404 ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
<meta name="google-site-verification" content={googleVerification} />
{naverVerification && <meta name="naver-site-verification" content={naverVerification} />}
<meta name="theme-color" content="#0f121d" />
{!is404 && <link rel="canonical" href={canonical} />}
{!is404 && enHref && <link rel="alternate" hreflang="x-default" href={enHref} />}
<link rel="sitemap" type="application/xml" href={`${root}sitemap.xml`} />
<link rel="alternate" type="application/rss+xml" href={`${root}rss.xml`} title="agent-tokenomics RSS" />
<link rel="alternate" type="text/plain" href={`${root}llms.txt`} title="LLM documentation index" />
<link rel="alternate" type="text/plain" href={`${root}llms-full.txt`} title="Full documentation corpus" />
{!is404 && <link rel="alternate" type="text/markdown" href={`${canonical}index.md`} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={isHome ? "website" : "article"} />
<meta property="og:locale" content={isKo ? "ko_KR" : "en_US"} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="agent-tokenomics: measure LLM token cost and task quality" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content="agent-tokenomics: measure LLM token cost and task quality" />
{filteredHead.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
{!is404 && <script type="application/ld+json" set:html={jsonLd} />}
