---
import MarkdownContent from "@astrojs/starlight/components/MarkdownContent.astro";
const { entry, lang } = Astro.locals.starlightRoute;
const isKo = lang === "ko";
---

<MarkdownContent>
  {entry?.data.created && (
    <aside class="document-dates not-content" aria-label={isKo ? "문서 날짜" : "Document dates"}>
      <dl>
        <div>
          <dt>{entry.data.dateSource === "git"
            ? (isKo ? "작성일 (Git 최초 등록 기준)" : "Created (first Git record)")
            : (isKo ? "작성 기록일 (최초 작성일 미확인)" : "Recorded on (creation date unknown)")}</dt>
          <dd><time datetime={entry.data.created}>{entry.data.created}</time></dd>
        </div>
        <div>
          <dt>{isKo ? "수정일" : "Modified"}</dt>
          <dd><time datetime={entry.data.updated}>{entry.data.updated}</time></dd>
        </div>
        {entry.data.verified && (
          <div>
            <dt>{isKo ? "검증 기준일" : "Verified as of"}</dt>
            <dd><time datetime={entry.data.verified.toISOString().slice(0, 10)}>{entry.data.verified.toISOString().slice(0, 10)}</time></dd>
          </div>
        )}
      </dl>
    </aside>
  )}
  <slot />
</MarkdownContent>

<style is:global>
  .document-dates { font-size: .85rem; color: var(--sl-color-gray-2); margin-block: 1rem; }
  .document-dates dl { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem 1.5rem; margin: 0; }
  .document-dates dl div { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .5rem; }
  .document-dates dt { font-weight: 700; }
  .document-dates dd { margin: 0; }
  .document-dates time { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .answer-capsule { min-height: 8rem; contain: layout; padding: 1rem; border-inline-start: .25rem solid var(--sl-color-accent); margin-block: 1rem; }
  .answer-capsule dt { font-weight: 700; }
  .answer-capsule dd { margin-inline-start: 0; margin-block-end: .5rem; }
</style>
